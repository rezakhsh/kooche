# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Public base URL for images (imgproxy behind Cloudflare in production)
IMAGE_URL=http://localhost:8081

# --- PostgreSQL 18 + PostGIS ---
DATABASE_URL=postgres://app:app@localhost:5432/classifieds

# --- Valkey (Redis-compatible) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (added with the search feature) ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# --- Object storage (S3 API: Garage locally, Cloudflare R2 or Hetzner in production) ---
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET_MEDIA=classifieds-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- imgproxy ---
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Auth ---
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Telegram bot used for phone verification (runs in the worker)
TELEGRAM_BOT_TOKEN=
# SMS fallback; in development codes are printed to the terminal
SMS_PROVIDER=console

# --- Email ---
EMAIL_FROM=
SMTP_URL=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=

# --- n8n (non-critical automation) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Cloudflare ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
