# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Public base URL for images: imgproxy behind Cloudflare (https://img-staging.peydoo.com on
# staging). Unset: listing pages show no photos (development without imgproxy).
IMAGE_URL=
# Time zone for dates shown in the interface (Jalali). Storage is always UTC.
APP_TIME_ZONE=Europe/Berlin
# `off` sends X-Robots-Tag: noindex on every page (development, staging). `on` in production only.
SEARCH_INDEXING=off

# --- PostgreSQL 18 + PostGIS ---
# The cluster MUST be initialized with the built-in C.UTF-8 locale provider (docs/schema.md,
# decision 3). initdb reads this only on the very first start with an empty data directory; it
# can't be changed later without a dump and restore. compose.yaml sets it for local development.
# On a server, set it on the PostgreSQL service before its first start.
POSTGRES_INITDB_ARGS="--locale-provider=builtin --builtin-locale=C.UTF-8"
# Running code: the Next.js app connects as classifieds_app, the worker as classifieds_worker
DATABASE_URL=postgres://classifieds_app:app@localhost:5432/classifieds
WORKER_DATABASE_URL=postgres://classifieds_worker:worker@localhost:5432/classifieds
# Migrations and seeds only (npm run db:migrate, npm run db:seed): the owner role
MIGRATION_DATABASE_URL=postgres://classifieds_owner:owner@localhost:5432/classifieds
# Tests (npm test), as the owner. Must end in _test: it is dropped and recreated on every run.
TEST_DATABASE_URL=postgres://classifieds_owner:owner@localhost:5432/classifieds_test

# --- Valkey (Redis-compatible) ---
REDIS_URL=redis://localhost:6379
# Tests (npm test): a separate Valkey database. It is emptied on every run.
TEST_REDIS_URL=redis://localhost:6379/15

# --- Meilisearch (keyword search) ---
# On the server: the classifieds-meilisearch service on the `coolify` network, never public. The
# master key stays on that service and in /root/.secrets/meilisearch.env; web and worker get keys
# derived from it (docs/setup.md, "Keyword search and saved searches"). Unset: keyword search runs
# on PostgreSQL and no index is kept. compose.yaml's service uses the master key below for both.
MEILI_URL=http://localhost:7700
# Web: may only search the listings index
MEILI_SEARCH_KEY=dev-only-meili-master-key-0123456789
# Worker: may write the listings index
MEILI_WRITE_KEY=dev-only-meili-master-key-0123456789
# Tests (npm test): a Meilisearch with this master key; each test file uses indexes of its own
TEST_MEILI_URL=http://localhost:7700
TEST_MEILI_MASTER_KEY=dev-only-meili-master-key-0123456789

# --- Object storage (S3 API, Cloudflare R2 with EU jurisdiction) ---
# Web and worker. The R2 API token's access key id and secret, limited to the bucket ("Object
# Read & Write"). Unset in development: photo upload is switched off.
# R2: S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com  S3_REGION=auto
#     S3_BUCKET_MEDIA=classifieds-media-staging (staging) / classifieds-media (production)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_MEDIA=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- imgproxy ---
# Web only (signs image URLs); the same values are set on the imgproxy service.
# Hex, e.g. `openssl rand -hex 32` each.
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Auth ---
# Better Auth secret (web): 32+ random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Google (and Apple) sign-in come later; Google links to existing users by verified email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Telegram phone verification bot. The token is for the worker only; the web only needs the
# @username (without @) for the t.me link. One bot per environment: only one process may poll it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=kooche_dev_bot
# HMAC key for SMS codes (web): 32+ random characters
PHONE_CODE_SECRET=dev-only-phone-code-secret-change-me-0123
# SMS fallback: `log` writes codes to the log (development, staging). Real provider later.
SMS_PROVIDER=log

# --- Cloudflare Turnstile (web): sign-in and publishing ---
# One widget per environment (Cloudflare dashboard → Turnstile), limited to that environment's
# domain. Required in production. Unset in development: no widget and no check. For a local
# production build use Cloudflare's test keys: site key 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA (always passes), 2x00000000000000000000AB with
# 2x0000000000000000000000000000000AA (always fails). Test secrets need a local APP_URL.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (login codes from the web, expiry reminders from the worker) ---
# The worker also needs APP_URL (links in the reminder) and these two.
# Amazon SES SMTP, eu-central-1. Unset in development: codes are printed to the terminal.
# SMTP_URL=smtp://<smtp-user>:<url-encoded-smtp-password>@email-smtp.eu-central-1.amazonaws.com:587
# EMAIL_FROM="Display name <no-reply@example.com>"
SMTP_URL=
EMAIL_FROM=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=

# --- n8n (non-critical automation) ---
# Worker: the owner's Telegram alert for new reports and appeals, through the n8n workflow
# "Peydoo – admin alerts", signed with HMAC-SHA256 (src/modules/admin/alert.ts). Unset: no alert.
N8N_ADMIN_ALERT_URL=
N8N_WEBHOOK_SECRET=

# --- Cloudflare ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Web (post-deployment purge) and worker (purges the browse pages of a listing staff took down or
# restored). Unset in the worker: Cloudflare keeps those pages up to 60 seconds.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# --- Error monitoring (Sentry, EU region; docs/setup.md, "Error monitoring") ---
# Web and worker. Only a DSN of Sentry's EU region is accepted
# (https://<key>@o<org>.ingest.de.sentry.io/<project>). Unset (development, tests): monitoring is off,
# no browser code is loaded and /api/monitoring answers 404. One project; SENTRY_ENVIRONMENT
# (staging or production) is required with a DSN. Coolify sets SOURCE_COMMIT, which names the release.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Admin page (roadmap step 8) ---
# The secret first path segment of the admin page: /<ADMIN_PATH>/… (16–64 lowercase letters and
# digits, e.g. `openssl rand -hex 12`). Web and worker (the alert's link). Unset: no admin page.
ADMIN_PATH=
