{
  "name": "classifieds",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node24 --external:msgpackr-extract --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/worker.js",
    "start": "node .next/standalone/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "check:rtl": "node scripts/check-logical-classes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vazirmatn": "33.0.3",
    "vitest": "5.0.5"
  }
}
