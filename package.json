{
  "name": "classifieds",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node24 --external:msgpackr-extract --external:sharp --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/worker.js",
    "build:purge": "esbuild src/deploy/purge-cache.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/purge-cache.js",
    "build:migrate": "esbuild src/db/migrate.ts src/deploy/trigger.ts --bundle --platform=node --format=esm --target=node24 --entry-names=[name] --outdir=dist/migrate",
    "start": "node .next/standalone/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "check:rtl": "node scripts/check-logical-classes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@sentry/browser": "11.5.0",
    "@sentry/core": "11.5.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.10",
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "libphonenumber-js": "1.13.15",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "nodemailer": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "thumbhash": "0.1.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vazirmatn": "33.0.3",
    "vitest": "5.0.5"
  }
}
